{
  "name": "invoice-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:production": "npm run build && playwright test --config playwright.production.config.js",
    "test:pdf:browser": "playwright test --config playwright.pdf.config.js",
    "build:pdf-test": "vite build --config e2e/pdf.vite.config.js",
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "pdfmake": "0.3.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "30.1.3",
    "oxlint": "^1.88.0",
    "pdfjs-dist": "6.4.299",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  }
}
